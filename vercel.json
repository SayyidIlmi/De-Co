{
    "version": 2,
    "framework": null,
    "buildCommand": "echo 'Murni HTML CSS, skip compile Node!'",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.0"
        }
    },
    "routes": [
        {
            "src": "/(css|js|images|favicon.ico)(.*)",
            "dest": "public/$1$2"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}